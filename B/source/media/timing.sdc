create_clock -name sys_clock -period 20 -waveform {0 10} [get_ports clk]
create_clock -name rx_clock -period 8 -waveform {0 4} [get_ports rx_clk]
create_generated_clock -name net_clock -source [get_ports clk] -master_clock sys_clock -multiply_by 2.5 [get_pins {u_link/u_pll/pll_inst.clkc[0]}]
set_input_delay -clock rx_clock -max 2.6 [get_ports {rxd[*] rx_ctl}]
set_input_delay -clock rx_clock -min 1.0 [get_ports {rxd[*] rx_ctl}]
set_input_delay -clock rx_clock -clock_fall -add_delay -max 2.6 [get_ports {rxd[*] rx_ctl}]
set_input_delay -clock rx_clock -clock_fall -add_delay -min 1.0 [get_ports {rxd[*] rx_ctl}]
create_generated_clock -name phy_capture -source [get_pins {u_link/u_pll/pll_inst.clkc[0]}] -master_clock net_clock -edges {1 2 3} -edge_shift {2 2 2} [get_ports tx_clk]
set_output_delay -clock phy_capture -max 1.0 [get_ports {txd[*] tx_ctl}]
set_output_delay -clock phy_capture -min -1.0 [get_ports {txd[*] tx_ctl}]
set_output_delay -clock phy_capture -clock_fall -add_delay -max 1.0 [get_ports {txd[*] tx_ctl}]
set_output_delay -clock phy_capture -clock_fall -add_delay -min -1.0 [get_ports {txd[*] tx_ctl}]
set_max_delay 7.5 -datapath_only -from [get_regs {u_link/u_wire/send_request}] -to [get_regs {u_link/u_wire/send_req_sync[0]}]
set_false_path -hold -from [get_regs {u_link/u_wire/send_request}] -to [get_regs {u_link/u_wire/send_req_sync[0]}]
set_max_delay 7.5 -datapath_only -from [get_regs {u_link/u_wire/send_ack}] -to [get_regs {u_link/u_wire/send_ack_sync[0]}]
set_false_path -hold -from [get_regs {u_link/u_wire/send_ack}] -to [get_regs {u_link/u_wire/send_ack_sync[0]}]
set_max_delay 7.5 -datapath_only -from [get_regs {u_link/u_wire/recv_request}] -to [get_regs {u_link/u_wire/recv_req_sync[0]}]
set_false_path -hold -from [get_regs {u_link/u_wire/recv_request}] -to [get_regs {u_link/u_wire/recv_req_sync[0]}]
set_max_delay 7.5 -datapath_only -from [get_regs {u_link/u_wire/recv_ack}] -to [get_regs {u_link/u_wire/recv_ack_sync[0]}]
set_false_path -hold -from [get_regs {u_link/u_wire/recv_ack}] -to [get_regs {u_link/u_wire/recv_ack_sync[0]}]
set_max_delay 20 -datapath_only -from [get_regs {u_link/u_wire/send_hold[*]}] -to [get_regs {u_link/u_wire/tx_info[*]}]
set_false_path -hold -from [get_regs {u_link/u_wire/send_hold[*]}] -to [get_regs {u_link/u_wire/tx_info[*]}]
set_max_delay 20 -datapath_only -from [get_regs {u_link/u_wire/recv_hold[*]}] -to [get_regs {u_link/u_wire/recv_info[*]}]
set_false_path -hold -from [get_regs {u_link/u_wire/recv_hold[*]}] -to [get_regs {u_link/u_wire/recv_info[*]}]
set_false_path -to [get_regs {u_link/tx_enable_sync[0] u_link/rx_enable_sync[0]}]
set_false_path -from [get_ports rst_n]
set_false_path -through [get_nets {u_link/async_reset_request}]
set_false_path -from [get_ports mdio]
set_max_delay 20 -to [get_ports {seg_data[*] seg_sel[*] mdio mdc sd_ncs sd_dclk sd_mosi}]

set_false_path -from [get_ports sw_spectrum]
