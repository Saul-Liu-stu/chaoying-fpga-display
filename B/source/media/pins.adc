# HX4S20: schematic 2_FPGA + official32 active ADC; SEG uses accepted FAB pins.
set_pin_assignment {clk} {LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {rst_n} {LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {rx_clk} {LOCATION = T14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {rx_ctl} {LOCATION = T13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {rxd[0]} {LOCATION = P6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {rxd[1]} {LOCATION = M6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
