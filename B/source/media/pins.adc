set_pin_assignment {txd[3]} {LOCATION = T8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {mdc} {LOCATION = L13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {mdio} {LOCATION = M13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_data[0]} {LOCATION = C15; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_data[1]} {LOCATION = C16; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_data[2]} {LOCATION = B6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_data[3]} {LOCATION = A5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
