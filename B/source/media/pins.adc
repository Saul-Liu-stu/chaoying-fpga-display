set_pin_assignment {seg_data[6]} {LOCATION = A7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_data[7]} {LOCATION = A6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_sel[0]} {LOCATION = E12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_sel[1]} {LOCATION = E10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {seg_sel[2]} {LOCATION = C13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
