set_pin_assignment {rxd[3]} {LOCATION = N9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {tx_clk} {LOCATION = T12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
